# ScousGiftCardExchange — copy to .env on your VPS and fill in the real values.
# Never commit the real .env.

# ---------------------------------------------------------------- app
PORT=3000
# Public address of the site; used in the links inside alert emails.
APP_URL=https://scousgiftcardexchange.com

# ------------------------------------------------------------ database
# Same cloud database the hosted app uses. The VITE_ values are safe to be
# public (they are the browser keys); the service role key is server-only.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
SUPABASE_PROJECT_ID=your-project-ref
# Server-only. Bypasses all access rules — keep it secret.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxx

# ---------------------------------------------------------------- mail
# Cloudflare Email Service SMTP
SMTP_HOST=smtp.mx.cloudflare.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=api_token
SMTP_PASS=cfut_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender identity shown in the inbox
APP_EMAIL_FROM=welcome@alert.scousgiftcardexchange.com
APP_EMAIL_FROM_NAME=ScousGiftCardExchange
APP_EMAIL_REPLY_TO=welcome@alert.scousgiftcardexchange.com

# -------------------------------------------------------------- extras
# Shared secret for scheduled jobs, if you use them.
LOVABLE_CRON_SECRET=
